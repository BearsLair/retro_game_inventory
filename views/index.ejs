<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Retro Game Inventory</title>
  </head>
  <body>
    <h1>Inventory</h1>
    <ol>
    <% locals.stock.forEach(item => { %>
        <li>Name: <%= item.name %> | Console: <%= item.console %> | Quantity in Stock: <%= item.quantity %> | Price: <%= item.price %> </li>
    <% }); %>
    </ol>
  </body>
</html>
