<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Retro Game Store - Add Game</title>
  </head>
  <body>
    <h1>Add Game</h1>
    <form action="/form" method="POST">
      <label for="name"></label>
      <input name="name" />
      <label for="console"></label>
      <input name="console" />
      <label for="quantity"></label>
      <input name="quantity" />
      <label for="price"></label>
      <input name="price" />
      <label for="developer"></label>
      <input name="developer" />
      <label for="publisher"></label>
      <input name="publisher" />
      <label for="genre"></label>
      <input name="genre" />
      <label for="releaseyear"></label>
      <input name="releaseyear" />
    </form>
  </body>
</html>
