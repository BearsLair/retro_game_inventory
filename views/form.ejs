<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Retro Game Store - Add Game</title>
  </head>
  <body>
    <h1>Add Game</h1>
    <a href="/">Back to Inventory</a>
    <%- include("partials/error.ejs") %>
    <form
      action="/form"
      method="POST"
      style="margin-top: 10px; display: flex; flex-direction: column"
    >
      <div>
        <label for="name">Name: </label>
        <input name="name" />
      </div>
      <div>
        <label for="system">Console: </label>
        <input name="system" />
      </div>
      <div>
        <label for="quantity">Quantity: </label>
        <input name="quantity" />
      </div>
      <div>
        <label for="price">Price: </label>
        <input name="price" />
      </div>
      <div>
        <label for="developer">Developer: </label>
        <input name="developer" />
      </div>
      <div>
        <label for="publisher">Publisher: </label>
        <input name="publisher" />
      </div>
      <div>
        <label for="genre">Genre: </label>
        <input name="genre" />
      </div>
      <div>
        <label for="releaseyear">Release Year: </label>
        <input name="releaseyear" />
      </div>
      <button type="submit" style="width: fit-content">Submit</button>
    </form>
  </body>
</html>
