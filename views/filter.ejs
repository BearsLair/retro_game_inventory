<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Retro Game Store - Filter</title>
  </head>
  <body>
    <h1>Filter Games</h1>
    <h4>Filter Games</h4>

    <form action="results" method="GET">
      <label for="system">By Console: </label>
      <input type="text" name="system" />
      <button type="submit">Submit</button>
    </form>
    <form action="results" method="GET">
      <label for="developer">By Developer: </label>
      <input type="text" name="developer" />
      <button type="submit">Submit</button>
    </form>
    <form action="results" method="GET">
      <label for="publisher">By Publisher: </label>
      <input type="text" name="publisher" />
      <button type="submit">Submit</button>
    </form>
    <form action="results" method="GET">
      <label for="genre">By Genre: </label>
      <input type="text" name="genre" />
      <button type="submit">Submit</button>
    </form>
    <form action="results" method="GET">
      <label for="releaseyear">By Release Year: </label>
      <input type="text" name="releaseyear" />
      <button type="submit">Submit</button>
    </form>
    <a href="/">Back to Inventory</a>
  </body>
</html>
